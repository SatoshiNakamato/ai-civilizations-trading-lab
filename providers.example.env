# Copy to ~/.config/ai-civilization/providers.env on your device.
# NEVER commit the real file or real API keys.
export AGENTROUTER_API_KEY='REPLACE_ME'
export YDC_API_KEY='REPLACE_ME'

# Bankr wallet keys: host-only secrets, never put these in git.
# Four keys service the 100-agent population round-robin (A001->key1 ... A100->key4).
export BANKR_API_KEY_1='REPLACE_ME'
export BANKR_API_KEY_2='REPLACE_ME'
export BANKR_API_KEY_3='REPLACE_ME'
export BANKR_API_KEY_4='REPLACE_ME'

# Token launches are OFF by default. To enable autonomous launches on your
# Bankr wallets, set both flags in your local providers.env only.
export BANKR_LIVE_DEPLOY='0'
export BANKR_AUTO_DEPLOY='0'
# Bankr API deploys default to Robinhood Chain; set to base for Base launches.
export BANKR_DEFAULT_CHAIN='robinhood'
